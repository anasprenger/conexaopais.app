# Copie este arquivo para .env e preencha com os dados do seu MySQL.
# O arquivo .env não vai para o repositório.

# Porta da API (o app usa a 3333 por padrão)
PORT=3333

# Conexão com o MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=sua_senha_do_mysql
DB_NAME=conexao_pais

# Autenticação (JWT)
# Segredo que assina os tokens: texto longo e aleatório (mínimo de 32 caracteres). Nunca publique o valor real.
# Para gerar um e gravar neste arquivo automaticamente: npm run jwt:segredo
JWT_SECRET=
# Validade do token (ex.: 1h, 12h, 7d). Depois desse prazo o app pede login de novo.
JWT_EXPIRES_IN=7d
