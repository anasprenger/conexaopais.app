# Copie este arquivo para .env e preencha. O arquivo .env não vai para o repositório.
# A API usa o MESMO banco e as MESMAS contas do site Conexão Pais (projeto no Supabase).

# Porta da API (o app usa a 3333 por padrão)
PORT=3333

# Banco de dados: PostgreSQL do projeto Conexão Pais no Supabase.
# Onde pegar: painel do Supabase > botão "Connect" > aba "Connection String" > "Session pooler".
# Troque [YOUR-PASSWORD] pela senha do banco (Project Settings > Database). Nunca publique este valor.
DATABASE_URL=postgresql://postgres.SEU_ID_DO_PROJETO:SUA_SENHA_DO_BANCO@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Supabase Auth (contas do site): usado no login e no cadastro.
# Onde pegar: Project Settings > API Keys. Use a chave "publishable" (pública, a mesma do site).
SUPABASE_URL=https://SEU_ID_DO_PROJETO.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# Endereço do site: usado no link de confirmação de e-mail do cadastro e nos PDFs da revista
SITE_URL=https://conexaopais.com

# Autenticação do app (JWT gerado pela própria API)
# Segredo que assina os tokens: texto longo e aleatório (mínimo de 32 caracteres). Nunca publique o valor real.
# Para gerar um e gravar neste arquivo automaticamente: npm run jwt:segredo
JWT_SECRET=
# Validade do token (ex.: 1h, 12h, 7d). Depois desse prazo o app pede login de novo.
JWT_EXPIRES_IN=7d
