# Exemplos de requisições para testar a API.
# No VS Code, instale a extensão "REST Client" e clique em "Send Request" acima de cada bloco.
# Antes: npm run jwt:segredo, npm run db:setup e npm run dev
#
# 1. Rode os três logins abaixo (família, profissional e admin): cada um guarda o token da conta.
# 2. As rotas protegidas usam esses tokens no cabeçalho "Authorization: Bearer <token>".

@api = http://localhost:3333/api
@tokenFamilia = {{loginFamilia.response.body.$.token}}
@tokenProfissional = {{loginProfissional.response.body.$.token}}
@tokenAdmin = {{loginAdmin.response.body.$.token}}

### Situação da API e do banco
GET {{api}}/status


# =============================================================================
# CADASTRO E LOGIN (rotas abertas)
# =============================================================================

### Criar conta de família (a senha é salva só como hash bcrypt)
POST {{api}}/usuarios
Content-Type: application/json

{
  "nome": "Joana Lima",
  "email": "joana@exemplo.com",
  "senha": "123456",
  "tipo": "usuario"
}

### Criar conta profissional (fica "pendente" até o admin aprovar)
POST {{api}}/usuarios
Content-Type: application/json

{
  "nome": "Júlia Castro",
  "email": "julia@exemplo.com",
  "senha": "123456",
  "tipo": "profissional",
  "profissao": "Pedagoga",
  "registro": "MEC 12345"
}

### Login da família: devolve { token, usuario }
# @name loginFamilia
POST {{api}}/auth/login
Content-Type: application/json

{ "email": "familia@conexaopais.test", "senha": "123456" }

### Login da profissional aprovada (Dra. Helena Prado)
# @name loginProfissional
POST {{api}}/auth/login
Content-Type: application/json

{ "email": "profissional@conexaopais.test", "senha": "123456" }

### Login da administração
# @name loginAdmin
POST {{api}}/auth/login
Content-Type: application/json

{ "email": "admin@conexaopais.test", "senha": "123456" }

### Login com senha errada (401, sem token)
POST {{api}}/auth/login
Content-Type: application/json

{ "email": "profissional@conexaopais.test", "senha": "errada" }


# =============================================================================
# TOKEN (middleware autenticar)
# =============================================================================

### Quem está logado (200)
GET {{api}}/auth/perfil
Authorization: Bearer {{tokenFamilia}}

### Sem token (401)
GET {{api}}/auth/perfil

### Token inválido ou adulterado (401)
GET {{api}}/auth/perfil
Authorization: Bearer eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiIxIiwibml2ZWwiOiJhZG1pbiJ9.assinatura-falsa


# =============================================================================
# ARTIGOS: CRUD da entidade principal
# =============================================================================

### Listar artigos: aberto a visitantes (busca e categoria opcionais)
GET {{api}}/artigos?busca=rotina&categoria=Educação

### Artigo completo: aberto a visitantes
GET {{api}}/artigos/1

### Publicar sem token (401)
POST {{api}}/artigos
Content-Type: application/json

{
  "titulo": "Um artigo qualquer",
  "categoria": "Educação",
  "resumo": "Este resumo tem mais de vinte caracteres.",
  "conteudo": "Este texto também precisa ter pelo menos cinquenta caracteres para passar."
}

### Publicar com conta de família (403: nível não permite)
POST {{api}}/artigos
Authorization: Bearer {{tokenFamilia}}
Content-Type: application/json

{
  "titulo": "Um artigo qualquer",
  "categoria": "Educação",
  "resumo": "Este resumo tem mais de vinte caracteres.",
  "conteudo": "Este texto também precisa ter pelo menos cinquenta caracteres para passar."
}

### Publicar como profissional aprovada (201). O autor vem do token.
# @name novoArtigo
POST {{api}}/artigos
Authorization: Bearer {{tokenProfissional}}
Content-Type: application/json

{
  "titulo": "A volta às aulas sem drama",
  "categoria": "Educação",
  "resumo": "Pequenos combinados que ajudam na primeira semana de aula.",
  "conteudo": "Comece a rotina de sono uma semana antes.\n\nVisite a escola junto com a criança e mostre os espaços que ela vai usar.",
  "tags": ["Escola", "Rotina"]
}

### Editar o artigo criado acima com a conta da família (403: não é a autora)
PUT {{api}}/artigos/{{novoArtigo.response.body.$.id}}
Authorization: Bearer {{tokenFamilia}}
Content-Type: application/json

{
  "titulo": "Título trocado",
  "categoria": "Educação",
  "resumo": "Pequenos combinados que ajudam na primeira semana de aula.",
  "conteudo": "Comece a rotina de sono uma semana antes.\n\nVisite a escola junto com a criança."
}

### Editar o artigo criado acima com a conta da autora (200)
PUT {{api}}/artigos/{{novoArtigo.response.body.$.id}}
Authorization: Bearer {{tokenProfissional}}
Content-Type: application/json

{
  "titulo": "A volta às aulas sem drama (revisado)",
  "categoria": "Educação",
  "resumo": "Pequenos combinados que ajudam na primeira semana de aula.",
  "conteudo": "Comece a rotina de sono uma semana antes.\n\nVisite a escola junto com a criança.",
  "tags": "Escola, Rotina, Adaptação"
}

### Excluir o artigo criado acima (204; autora ou admin)
DELETE {{api}}/artigos/{{novoArtigo.response.body.$.id}}
Authorization: Bearer {{tokenProfissional}}


# =============================================================================
# COMUNIDADE (usuário logado)
# =============================================================================

### Comentários de um artigo: aberto a visitantes
GET {{api}}/artigos/1/comentarios

### Comentar (quem comenta é a conta do token)
# @name novoComentario
POST {{api}}/artigos/1/comentarios
Authorization: Bearer {{tokenFamilia}}
Content-Type: application/json

{ "texto": "Obrigada pelas dicas!" }

### Excluir o comentário com outra conta (403)
DELETE {{api}}/comentarios/{{novoComentario.response.body.$.id}}
Authorization: Bearer {{tokenProfissional}}

### Excluir o próprio comentário (204)
DELETE {{api}}/comentarios/{{novoComentario.response.body.$.id}}
Authorization: Bearer {{tokenFamilia}}

### Curtir / descurtir (liga e desliga)
POST {{api}}/artigos/1/interacoes
Authorization: Bearer {{tokenFamilia}}
Content-Type: application/json

{ "tipo": "curtida" }

### Curtidas e salvos da própria conta (id 3 = família)
GET {{api}}/usuarios/3/interacoes
Authorization: Bearer {{tokenFamilia}}

### Dados de outra conta (403: só a própria pessoa ou admin)
GET {{api}}/usuarios/2
Authorization: Bearer {{tokenFamilia}}

### Pergunta à equipe sem login (401)
POST {{api}}/mensagens
Content-Type: application/json

{ "tipo": "pergunta", "nome": "Visitante", "email": "visitante@exemplo.com", "mensagem": "Como lidar com birras?" }

### Pergunta à equipe com login (nome e e-mail vêm da conta)
POST {{api}}/mensagens
Authorization: Bearer {{tokenFamilia}}
Content-Type: application/json

{ "tipo": "pergunta", "mensagem": "Como lidar com birras na hora de dormir?" }

### Mensagem de contato: aberta a visitantes
POST {{api}}/mensagens
Content-Type: application/json

{
  "tipo": "contato",
  "nome": "Marina Souza",
  "email": "familia@conexaopais.test",
  "assunto": "Sugestão de pauta",
  "mensagem": "Gostaria de ler mais sobre adolescência."
}


# =============================================================================
# ADMINISTRAÇÃO (somente admin)
# =============================================================================

### Profissionais aguardando verificação (200 com admin)
GET {{api}}/usuarios?nivel=profissional&verificacao=pendente
Authorization: Bearer {{tokenAdmin}}

### A mesma lista com a conta da família (403)
GET {{api}}/usuarios?nivel=profissional&verificacao=pendente
Authorization: Bearer {{tokenFamilia}}

### Aprovar um cadastro profissional (troque o id; 4 = Carla Mendes)
PATCH {{api}}/usuarios/4/verificacao
Authorization: Bearer {{tokenAdmin}}
Content-Type: application/json

{ "verificacao": "aprovado" }


# =============================================================================
# CONTEÚDO PÚBLICO
# =============================================================================

### Diretório de profissionais e perfil
GET {{api}}/profissionais?busca=pediatria

###
GET {{api}}/profissionais/helena-prado

### Colunas e revista
GET {{api}}/colunas/entre-geracoes

###
GET {{api}}/revistas/edicao-03
